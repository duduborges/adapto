# Resend API for transactional email (contact form)
# https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender on Resend (must be on a domain verified in Resend — Gmail can't be used).
# Defaults to Adapto <contact@adapto-sh.com>. Visitor replies go to site.email.
RESEND_FROM=

# Where contact-form messages are delivered. Defaults to site.email (contact@adapto-sh.com).
CONTACT_TO=

# Google Calendar for the booking page (/book): same account and credentials as
# the Adapto Tracker. Server-side only, never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional. Defaults to the account's primary calendar.
GOOGLE_CALENDAR_ID=

# Public site origin, no trailing slash. Drives canonicals, sitemap and OG URLs.
# Leave unset on Vercel: production resolves from VERCEL_PROJECT_PRODUCTION_URL
# and previews resolve to their own deployment URL (which robots.ts de-indexes).
# Only set this for a non-Vercel host.
# Deixe vazio: em produção usa VERCEL_PROJECT_PRODUCTION_URL, em preview
# usa a URL do próprio deploy (que o robots.ts bloqueia da indexação).
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics stays off if empty.
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID. Stays off if empty; loads only after the visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID=
